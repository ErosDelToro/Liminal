---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import BookButton from "../../components/BookButton.astro";

export async function getStaticPaths() {
  const notes = (await getCollection("fieldnotes")).filter((n) => !n.data.draft);
  const retreats = await getCollection("retreats");
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, retreats },
  }));
}

const { entry, retreats } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Resolve the related retreats (for the back-links) from their slugs.
const related = data.relatedRetreats
  .map((slug) => retreats.find((r) => r.id === slug))
  .filter(Boolean);

const origin = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const noteUrl = `${origin}/field-notes/${entry.id}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
    description: data.dek,
    author: { "@type": "Person", "@id": `${origin}/#mehdi`, name: "Mehdi Moutahir" },
    publisher: { "@id": `${origin}/#org` },
    mainEntityOfPage: noteUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: "Retreats", item: `${origin}/retreats` },
      { "@type": "ListItem", position: 3, name: data.title, item: noteUrl },
    ],
  },
];
---

<Base
  title={`${data.title} | Field Note | Liminal Coaching`}
  description={data.dek}
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-6 pt-16 md:pt-24">
    {
      related[0] && (
        <a href={`/retreats/${related[0].id}`} class="font-heading text-sm text-apricot hover:underline">
          ← {related[0].data.title}
        </a>
      )
    }

    <p class="mt-8 eyebrow text-blueberry">Field note</p>
    <h1 class="mt-3">{data.title}</h1>
    <p class="mt-5 text-lg text-ink-soft">{data.dek}</p>
    <p class="mt-6 font-heading text-sm text-ink">By Mehdi Moutahir</p>

    <div
      class="prose mt-12 max-w-none text-ink-soft [&_a]:text-apricot [&_a]:underline [&_a]:underline-offset-2 [&_blockquote]:my-6 [&_blockquote]:border-l-2 [&_blockquote]:border-apricot [&_blockquote]:pl-5 [&_blockquote]:text-ink [&_em]:text-blueberry [&_h2]:mt-12 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:text-ink [&_h3]:mt-9 [&_h3]:mb-2 [&_h3]:text-xl [&_h3]:text-ink [&_hr]:my-10 [&_hr]:border-line [&_p]:mt-4 [&_p]:leading-relaxed [&_strong]:text-ink"
    >
      <Content />
    </div>
  </article>

  <!-- Back to the related retreats -->
  {
    related.length > 0 && (
      <section class="mx-auto max-w-3xl px-6 pt-14">
        <p class="eyebrow text-blueberry">The retreats behind this note</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {related.map((r) => (
            <a
              href={`/retreats/${r.id}`}
              class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 font-heading font-medium text-sm text-ink transition-colors hover:border-apricot hover:text-apricot"
            >
              {r.data.title}
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="mt-16 bg-paper-warm">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center">
      <h2 class="text-3xl">Curious where your own threshold leads?</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink-soft">
        The retreats are one way to do this work. A conversation is the place to start.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3">
        <BookButton label="Book a Free 30-Min Call" />
        <p class="text-sm text-blueberry">
          No pitch. A free 30-minute conversation to see if we're a fit.
        </p>
      </div>
    </div>
  </section>
</Base>
