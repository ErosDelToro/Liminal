---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Liminal Coaching" description="The page you're looking for can't be found.">
  <section class="mx-auto flex min-h-[55vh] max-w-2xl flex-col items-center justify-center px-6 py-24 text-center">
    <img src="/brand/mark.svg" alt="" class="mb-6 h-12 w-12" />
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-3">This page is in-between</h1>
    <p class="mt-6 text-lg text-ink-soft">
      The page you're looking for can't be found—it may have moved or never
      existed. Let's get you back on the path.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="inline-block rounded-full bg-apricot px-7 py-3 font-heading font-medium text-paper transition-colors hover:bg-apricot-bright"
      >
        Back home
      </a>
      <a
        href="/contact"
        class="inline-block rounded-full border border-ink px-7 py-3 font-heading font-medium text-ink transition-colors hover:bg-ink hover:text-paper"
      >
        Get in touch
      </a>
    </div>
  </section>
</Base>
