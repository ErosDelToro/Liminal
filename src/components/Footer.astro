---
import { CONTACT_EMAIL, SITE_TAGLINE, NAV_LINKS, SERVICE_LINKS } from "../config";
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <!-- Brand + email -->
      <div>
        <a href="/" class="mb-5 inline-flex items-center gap-3" aria-label="Liminal home">
          <img src="/brand/mark-reversed.svg" alt="" class="h-8 w-auto" />
          <span class="logotype text-lg text-paper">L<svg aria-hidden="true" viewBox="0 0 14 34" fill="none" style="display:inline-block;height:1em;vertical-align:-0.16em"><line x1="7" y1="7" x2="3" y2="27" stroke="#F97C3D" stroke-width="4" stroke-linecap="round"/></svg>m<svg aria-hidden="true" viewBox="0 0 14 34" fill="none" style="display:inline-block;height:1em;vertical-align:-0.16em"><line x1="7" y1="7" x2="3" y2="27" stroke="#F97C3D" stroke-width="4" stroke-linecap="round"/></svg>nal</span>
        </a>
        <p class="max-w-md text-sm leading-relaxed text-paper/60">{SITE_TAGLINE}</p>
        <a
          href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent("Coaching Info Request")}`}
          class="mt-5 inline-flex items-center gap-2 font-heading text-sm text-paper transition-colors hover:text-apricot-bright"
        >
          {CONTACT_EMAIL}
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <!-- Explore -->
      <nav aria-label="Footer">
        <p class="mb-4 eyebrow text-blueberry">Explore</p>
        <ul class="space-y-2">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-paper/70 transition-colors hover:text-apricot-bright">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li><a href="/faq" class="text-sm text-paper/70 transition-colors hover:text-apricot-bright">FAQ</a></li>
          <li><a href="/contact" class="text-sm text-paper/70 transition-colors hover:text-apricot-bright">Contact</a></li>
        </ul>
      </nav>

      <!-- Services -->
      <nav aria-label="Services">
        <p class="mb-4 eyebrow text-blueberry">Services</p>
        <ul class="space-y-2">
          {
            SERVICE_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-paper/70 transition-colors hover:text-apricot-bright">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-paper/10 pt-6 text-xs text-paper/50 sm:flex-row sm:justify-between">
      <p>&copy; {year} Liminal Coaching. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="/privacy-policy" class="transition-colors hover:text-apricot-bright">Privacy Policy</a>
        <a href="/terms-of-service" class="transition-colors hover:text-apricot-bright">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
