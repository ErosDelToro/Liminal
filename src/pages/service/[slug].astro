---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: services },
  }));
}

const { entry, all } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// "More Services": the two other services after this one, by order, wrapping.
const others = all
  .filter((s) => s.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);
const start = others.findIndex((s) => s.data.order > data.order);
const more = [...others.slice(start === -1 ? 0 : start), ...others].slice(0, 2);

const origin = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
    { "@type": "ListItem", position: 2, name: "Services", item: `${origin}/services` },
    { "@type": "ListItem", position: 3, name: data.title, item: `${origin}/service/${entry.id}` },
  ],
};
---

<Base
  title={data.seoTitle ?? `${data.title} | Liminal Coaching`}
  description={data.seoDescription}
  schema={breadcrumb}
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pb-8 pt-16 md:pt-24">
    <div class="flex items-center gap-4">
      <img src="/brand/mark.svg" alt="" class="h-9 w-9 shrink-0" />
      <h1 class="max-w-3xl">{data.title}</h1>
    </div>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft">{data.intro}</p>
  </section>

  <!-- Key points: six features -->
  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-x-12 gap-y-8 md:grid-cols-2">
      {
        data.features.map((f) => (
          <div>
            <h3 class="text-xl text-ink">{f.title}</h3>
            <p class="mt-2 text-ink-soft">{f.description}</p>
            {f.readMore && (
              <a
                href={f.readMore.href}
                class="mt-2 inline-flex items-center gap-1.5 font-heading text-sm font-medium text-apricot hover:underline"
              >
                {f.readMore.label}
                <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Approach (coaching pages only) -->
  {
    data.approach && (
      <section class="bg-paper-warm">
        <div class="mx-auto max-w-6xl px-6 py-20">
          <p class="eyebrow">Approach</p>
          <h2 class="mt-3 max-w-2xl">{data.approach.heading}</h2>
          <div class="mt-8 max-w-2xl space-y-4 text-ink-soft [&_p]:leading-relaxed">
            <Content />
            <a
              href="/contact"
              class="mt-2 inline-flex items-center gap-2 font-heading font-medium text-ink underline underline-offset-4 hover:text-apricot"
            >
              Get in touch
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- More services -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="mb-10">More services</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {
        more.map((s) => (
          <a
            href={`/service/${s.id}`}
            class="group flex flex-col gap-4 rounded-2xl border border-line bg-paper-warm/50 p-8 transition-shadow hover:shadow-md"
          >
            <div class="flex items-center gap-3">
              <img src="/brand/mark.svg" alt="" class="h-7 w-7 shrink-0" />
              <h3 class="text-ink">{s.data.title}</h3>
            </div>
            <p class="text-ink-soft">{s.data.intro.slice(0, 120)}…</p>
            <span class="mt-2 inline-flex items-center gap-2 font-heading font-medium text-sm text-apricot">
              Read more
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <Cta />
</Base>
