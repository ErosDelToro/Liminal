---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import BookButton from "../../components/BookButton.astro";
import { getImage } from "../../lib/images";

export async function getStaticPaths() {
  // Exclude drafts (e.g. the example template) so they never build or index.
  const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hero = getImage(data.heroImage);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long" });
---

<Base title={`${data.title} | Liminal Coaching`} description={data.description} ogImage={hero?.src}>
  <article class="mx-auto max-w-3xl px-6 pt-16 md:pt-24">
    <a href="/blog" class="font-heading text-sm text-apricot hover:underline">← All articles</a>
    <time class="mt-8 block text-sm text-blueberry">{fmt(data.pubDate)}</time>
    <h1 class="mt-3">{data.title}</h1>
    <p class="mt-5 text-lg text-ink-soft">{data.description}</p>

    {
      hero && (
        <Image
          src={hero}
          alt={data.title}
          class="mt-10 aspect-[16/9] w-full rounded-2xl object-cover"
          widths={[600, 1000]}
          sizes="(max-width: 768px) 100vw, 768px"
          loading="eager"
        />
      )
    }

    <div
      class="prose mt-10 max-w-none text-ink-soft [&_a]:text-apricot [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-2xl [&_h2]:text-ink [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-xl [&_h3]:text-ink [&_li]:mt-1 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_p]:leading-relaxed [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6"
    >
      <Content />
    </div>
  </article>

  <!-- End-of-post CTA -->
  <section class="mt-20 bg-paper-warm">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center">
      <h2 class="text-3xl">Ready to navigate your own transition?</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink-soft">
        Whether it's an executive role shift, a career pivot, or organizational
        change, let's talk about how we might work together.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3">
        <BookButton label="Book a Free 30-Min Call" />
        <p class="text-sm text-blueberry">
          No pitch. A free 30-minute conversation to see if we're a fit.
        </p>
      </div>
    </div>
  </section>
</Base>
