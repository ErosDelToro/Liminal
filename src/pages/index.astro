---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import BookButton from "../components/BookButton.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getImage } from "../lib/images";

// Services, in defined order (Transition, Executive, Speaking, Workshops, Retreat).
const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Recent posts, if any exist yet.
const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const partners = [
  { name: "RIF", logo: "/images/partners/rif.png" },
  { name: "IGT", logo: "/images/partners/igt.webp" },
  { name: "Economic Progress Institute", logo: "/images/partners/epi.png" },
  { name: "Global Giving", logo: "/images/partners/global-giving.png" },
  { name: "Bank of America", logo: "/images/partners/bank-of-america.png" },
];

const heroImg = getImage("hero");
const aboutImg = getImage("mehdi-portrait");

const testimonials = [
  {
    quote:
      "Mehdi holds a space with equal parts gravitas, humor, and empathy. He made sure that our group got the theoretical and academic content on psychological safety that undergirds his presentation while also making sure we had practical information we could use in our work and daily life. He is keenly aware of the energy in the room and is responsive to it.",
    name: "Rodney Eric Lopez",
    title: "CEO",
    avatar: getImage("client-rodney"),
  },
  {
    quote:
      "I left the session energized, informed and with the tools to analyze and adjust a range of mental states and situations. Mehdi brings intelligence and experience, but more importantly, he brings authenticity.",
    name: "Stacy Jones",
    title: "Professor",
    avatar: getImage("client-stacy"),
  },
  {
    quote:
      "Through his coaching I have learned to embrace and appreciate life's transitions, make peace with the imposter syndrome, and become a creative leader while optimizing the strengths of my team. Mehdi has given me the confidence to design the life that supports my values.",
    name: "Weayonnoh Nelson-Davies",
    title: "Executive Director",
    avatar: getImage("client-weayonnoh"),
  },
  {
    quote:
      "Mehdi is an excellent facilitator and storyteller. I loved how he weaved personal stories into his presentation which was grounded in research. He has a calm, clear manner of presenting content that will resonate with a diverse group.",
    name: "Kilah Walters-Clinton",
    title: "Director",
    avatar: getImage("client-kilah"),
  },
];
---

<Base title="Liminal Coach | Mehdi Moutahir">
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Identity &amp; transitions coaching</p>
        <h1 class="mt-4">Ready for your breakthrough?</h1>
        <p class="mt-6 max-w-xl text-lg text-ink-soft">
          Liminal is a space for adults authoring a new chapter. Through a
          personalized journey that blends psychological insight with practical
          strategy, we turn the threshold between who you were and who you're
          becoming into a catalyst for reinvention, purpose, and impact.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <BookButton label="Book a Call" />
          <a
            href="#services"
            class="inline-block rounded-full border border-ink px-7 py-3 font-heading font-medium text-ink transition-colors hover:bg-ink hover:text-paper"
          >
            Explore services
          </a>
        </div>
      </div>
      {
        heroImg && (
          <Image
            src={heroImg}
            alt="A coaching conversation"
            class="w-full rounded-2xl object-cover shadow-sm"
            widths={[500, 900]}
            sizes="(max-width: 1024px) 100vw, 560px"
            loading="eager"
          />
        )
      }
    </div>
  </section>

  <!-- Partners -->
  <section class="mx-auto max-w-6xl px-6 py-14">
    <p class="text-center eyebrow text-blueberry">Trusted by teams at</p>
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {
        partners.map((p) => (
          <li>
            <img
              src={p.logo}
              alt={p.name}
              class="h-8 w-auto max-w-[140px] object-contain opacity-60 grayscale transition hover:opacity-100 hover:grayscale-0 md:h-10"
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Services -->
  <section id="services" class="scroll-mt-24 bg-paper-warm">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="eyebrow">What I offer</p>
      <h2 class="mt-3 max-w-2xl">Ways we can work together</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <a
              href={`/service/${s.id}`}
              class="group flex flex-col gap-4 rounded-2xl border border-line bg-paper p-8 transition-shadow hover:shadow-md"
            >
              <img src="/brand/mark.svg" alt="" class="h-9 w-9" />
              <h3 class="text-xl text-ink">{s.data.title}</h3>
              <p class="flex-1 text-ink-soft">{s.data.intro.slice(0, 150)}…</p>
              <span class="mt-2 inline-flex items-center gap-2 font-heading font-medium text-sm text-apricot">
                Learn more
                <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))
        }

        <!-- Retreats: a category of its own, linking to the overview. -->
        <a
          href="/retreats"
          class="group flex flex-col gap-4 rounded-2xl border border-line bg-ink p-8 text-paper transition-shadow hover:shadow-md"
        >
          <img src="/brand/mark-reversed.svg" alt="" class="h-9 w-9" />
          <h3 class="text-xl text-paper">Retreats</h3>
          <p class="flex-1 text-paper/70">
            Immersive experiences—Liminal Odyssey, Ascent, Silence, and
            Harvest—for those ready to step away and author a new chapter.
          </p>
          <span class="mt-2 inline-flex items-center gap-2 font-heading font-medium text-sm text-apricot-bright">
            Explore retreats
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- About preview -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      {
        aboutImg && (
          <Image
            src={aboutImg}
            alt="Mehdi Moutahir"
            class="w-full rounded-2xl object-cover shadow-sm"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 100vw, 500px"
          />
        )
      }
      <div>
        <p class="eyebrow">Meet your coach</p>
        <h2 class="mt-3 text-3xl">Mehdi Moutahir</h2>
        <p class="mt-6 text-ink-soft">
          Mehdi embodies the art of living with purpose and intention. Drawing on
          diverse experience in education, entrepreneurship, psychology, and
          personal development, he helps clients create harmony between their
          passions, talents, and contributions—and define success on their own
          terms.
        </p>
        <a
          href="/about"
          class="mt-6 inline-flex items-center gap-2 font-heading font-medium text-ink underline underline-offset-4 hover:text-apricot"
        >
          More about Mehdi
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="eyebrow">Client experiences</p>
      <h2 class="mt-3 max-w-2xl text-paper">Speak for themselves</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          testimonials.map((t) => (
            <figure class="flex flex-col gap-5 rounded-2xl border border-paper/10 bg-paper/5 p-8">
              <blockquote class="text-paper/85">“{t.quote}”</blockquote>
              <figcaption class="mt-auto flex items-center gap-4">
                {t.avatar && (
                  <Image
                    src={t.avatar}
                    alt={t.name}
                    class="h-12 w-12 rounded-full object-cover"
                    width={96}
                    height={96}
                  />
                )}
                <span>
                  <span class="block font-heading font-medium text-paper">{t.name}</span>
                  <span class="text-sm text-muted-on-dark">{t.title}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recent articles (only if posts exist) -->
  {
    posts.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-20">
        <div class="flex items-end justify-between">
          <div>
            <p class="eyebrow">From the blog</p>
            <h2 class="mt-3 text-3xl">Recent articles</h2>
          </div>
          <a href="/blog" class="hidden font-heading font-medium text-apricot hover:underline sm:block">
            All articles
          </a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <a href={`/post/${post.id}`} class="group block">
              <h3 class="text-lg text-ink group-hover:text-apricot">{post.data.title}</h3>
              <p class="mt-2 text-sm text-ink-soft">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <Cta />
</Base>
