---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import BookButton from "../components/BookButton.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getImage } from "../lib/images";

// Recent posts, if any exist yet.
const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const partners = [
  { name: "RIF", logo: "/images/partners/rif.png" },
  { name: "IGT", logo: "/images/partners/igt.webp" },
  { name: "Economic Progress Institute", logo: "/images/partners/epi.png" },
  { name: "Global Giving", logo: "/images/partners/global-giving.png" },
  { name: "Bank of America", logo: "/images/partners/bank-of-america.png" },
];

const heroImg = getImage("hero");
const aboutImg = getImage("mehdi-portrait");

const testimonials = [
  {
    quote:
      "Mehdi holds a space with equal parts gravitas, humor, and empathy. He made sure that our group got the theoretical and academic content on psychological safety that undergirds his presentation while also making sure we had practical information we could use in our work and daily life. He is keenly aware of the energy in the room and is responsive to it.",
    name: "Rodney Eric Lopez",
    title: "Author, Speaker & Founder",
    org: "Mad Hot Movement",
    avatar: getImage("client-rodney"),
  },
  {
    quote:
      "I left the session energized, informed and with the tools to analyze and adjust a range of mental states and situations. Mehdi brings intelligence and experience, but more importantly, he brings authenticity.",
    name: "Stacy Jones",
    title: "Educator & Equity Leadership Fellow",
    org: "Department of Education",
    avatar: getImage("client-stacy"),
  },
  {
    quote:
      "Through his coaching I have learned to embrace and appreciate life's transitions, make peace with the imposter syndrome, and become a creative leader while optimizing the strengths of my team. Mehdi has given me the confidence to design the life that supports my values.",
    name: "Weayonnoh Nelson-Davies",
    title: "Policy Advocate & Executive Director",
    org: "Economic Progress Institute",
    avatar: getImage("client-weayonnoh"),
  },
  {
    quote:
      "Mehdi is an excellent facilitator and storyteller. I loved how he weaved personal stories into his presentation which was grounded in research. He has a calm, clear manner of presenting content that will resonate with a diverse group.",
    name: "Kilah Walters-Clinton",
    title: "Social Justice Advocate & Executive Director",
    org: "Department of Health & Human Services",
    avatar: getImage("client-kilah"),
  },
];

// Client testimonials as Review nodes on the practice entity (resolved by @id
// from the site-wide graph in Base.astro). No aggregateRating: these quotes
// carry no star values, and inventing them would be dishonest and, as
// self-hosted reviews, ineligible for rich results anyway.
const origin = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${origin}/#org`,
  review: testimonials.map((t) => ({
    "@type": "Review",
    reviewBody: t.quote,
    author: { "@type": "Person", name: t.name },
  })),
};
---

<Base
  title="Transition & Executive Coaching | Liminal Coaching"
  description="Transition and executive coaching with Mehdi Moutahir: psychological insight and practical strategy to move through a career change, a new role, or a major crossroads."
  schema={reviewSchema}
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Identity &amp; transitions coaching</p>
        <h1 class="mt-4">Coaching for the space between chapters.</h1>
        <p class="mt-6 max-w-xl text-lg text-ink-soft">
          A liminal space is the in-between of a transition, where the old no
          longer fits and the new hasn't fully emerged.
        </p>
        <p class="mt-4 max-w-xl text-lg text-ink-soft">
          I work with leaders, founders, and people navigating exactly that: a
          career shift, a new role, or the quiet sense that a chapter is ending.
          We move through it together so you come out coherent, your life and
          values pulling the same way, and the next chapter yours to author.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <BookButton label="Book a Free 30-Min Call" />
          <a
            href="#services"
            class="inline-block rounded-full border border-ink px-7 py-3 font-heading font-medium text-ink transition-colors hover:bg-ink hover:text-paper"
          >
            Explore services
          </a>
        </div>
        <p class="mt-3 text-sm text-blueberry">
          No pitch. A free 30-minute conversation to see if we're a fit.
        </p>
      </div>
      {
        heroImg && (
          <Image
            src={heroImg}
            alt="A coaching conversation"
            class="w-full rounded-2xl object-cover shadow-sm"
            widths={[500, 900]}
            sizes="(max-width: 1024px) 100vw, 560px"
            loading="eager"
          />
        )
      }
    </div>
  </section>

  <!-- Partners -->
  <section class="mx-auto max-w-6xl px-6 py-14">
    <p class="text-center eyebrow text-blueberry">Trusted by teams at</p>
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
      {
        partners.map((p) => (
          <li>
            <img
              src={p.logo}
              alt={p.name}
              class="h-8 w-auto max-w-[140px] object-contain opacity-60 grayscale transition hover:opacity-100 hover:grayscale-0 md:h-10"
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Audience segmentation: help visitors self-identify -->
  <section id="services" class="scroll-mt-24 bg-paper-warm">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="eyebrow">How I can help</p>
      <h2 class="mt-3 max-w-2xl">Where are you right now?</h2>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <!-- For individuals -->
        <div class="flex flex-col rounded-2xl border border-line bg-paper p-8 transition-shadow hover:shadow-md">
          <p class="eyebrow text-blueberry">For individuals</p>
          <h3 class="mt-3 text-2xl text-ink">Individual &amp; career transitions</h3>
          <p class="mt-3 flex-1 text-ink-soft">
            Navigate a career shift, an identity change, or a major life
            crossroads with clarity and purpose.
          </p>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-heading font-medium text-sm">
            <a href="/service/transition-coaching" class="inline-flex items-center gap-1.5 text-apricot hover:underline">
              Transition Coaching
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="/retreats" class="inline-flex items-center gap-1.5 text-apricot hover:underline">
              Retreats
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>

        <!-- For leaders & organizations -->
        <div class="flex flex-col rounded-2xl border border-ink/10 bg-ink p-8 text-paper transition-shadow hover:shadow-md">
          <p class="eyebrow text-blueberry">For leaders &amp; organizations</p>
          <h3 class="mt-3 text-2xl text-paper">Executive coaching &amp; organizations</h3>
          <p class="mt-3 flex-1 text-paper/70">
            Develop your leadership, build psychological safety, and guide teams
            through change and growth.
          </p>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-heading font-medium text-sm">
            <a href="/service/executive-coaching" class="inline-flex items-center gap-1.5 text-apricot-bright hover:underline">
              Executive Coaching
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="/service/workshops" class="inline-flex items-center gap-1.5 text-apricot-bright hover:underline">
              Workshops
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="/service/speaking" class="inline-flex items-center gap-1.5 text-apricot-bright hover:underline">
              Speaking
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About preview -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      {
        aboutImg && (
          <Image
            src={aboutImg}
            alt="Mehdi Moutahir"
            class="w-full rounded-2xl object-cover shadow-sm"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 100vw, 500px"
          />
        )
      }
      <div>
        <p class="eyebrow">Meet your coach</p>
        <h2 class="mt-3 text-3xl">Mehdi Moutahir</h2>
        <p class="mt-6 text-ink-soft">
          Professor, founder, and coach, I have spent my career in and around
          profound change. I have crossed this passage many times myself. My work
          is helping you come through your own change coherent and aligned.
        </p>
        <a
          href="/about"
          class="mt-6 inline-flex items-center gap-2 font-heading font-medium text-ink underline underline-offset-4 hover:text-apricot"
        >
          More about Mehdi
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="eyebrow">Client experiences</p>
      <h2 class="mt-3 max-w-2xl text-paper">Speak for themselves</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          testimonials.map((t) => (
            <figure class="flex flex-col gap-5 rounded-2xl border border-paper/10 bg-paper/5 p-8">
              <blockquote class="text-paper/85">“{t.quote}”</blockquote>
              <figcaption class="mt-auto flex items-center gap-4">
                {t.avatar && (
                  <Image
                    src={t.avatar}
                    alt={t.name}
                    class="h-12 w-12 rounded-full object-cover"
                    width={96}
                    height={96}
                  />
                )}
                <span>
                  <span class="block font-heading font-medium text-paper">{t.name}</span>
                  <span class="block text-sm text-muted-on-dark">{t.title}</span>
                  {t.org && <span class="block text-sm text-paper/45">{t.org}</span>}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Recent articles (only if posts exist) -->
  {
    posts.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 py-20">
        <div class="flex items-end justify-between">
          <div>
            <p class="eyebrow">From the blog</p>
            <h2 class="mt-3 text-3xl">Recent articles</h2>
          </div>
          <a href="/blog" class="hidden font-heading font-medium text-apricot hover:underline sm:block">
            All articles
          </a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {posts.map((post) => (
            <a href={`/post/${post.id}`} class="group block">
              <h3 class="text-lg text-ink group-hover:text-apricot">{post.data.title}</h3>
              <p class="mt-2 text-sm text-ink-soft">{post.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <Cta />
</Base>
