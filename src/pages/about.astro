---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { Image } from "astro:assets";
import { getImage } from "../lib/images";

const portrait = getImage("mehdi-portrait");
const fieldNoteImg = getImage("fieldnote-ascent-castor");

// Mehdi's methodology pillars, from the live About page.
const pillars = [
  {
    title: "A global perspective",
    body: "A life spent adapting to new cultures and languages trained me to notice the assumptions people don't know they carry. In coaching, that becomes an ear for the beliefs and filters quietly shaping a client's choices.",
  },
  {
    title: "The whole person",
    body: "Coaching addresses your health, relationships, values, resources, and goals, across both personal and professional life, because no transition happens in just one part of a life.",
  },
  {
    title: "Evidence-based and experience-informed",
    body: "Grounded in graduate business education and doctoral research in organizational psychology, my work pairs evidence-based strategy with a constructivist view of change: that we respond to the maps we build of the world, and can rebuild them.",
  },
  {
    title: "Support between sessions",
    body: "Digital tools and analytics support the work between sessions, helping turn insight into consistent, measurable change.",
  },
];
---

<Base
  title="About Mehdi Moutahir | Liminal Coaching"
  description="Mehdi Moutahir guides individuals and organizations through the liminal phases of transformation: the in-between spaces where the old no longer fits and the new hasn't fully emerged."
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24">
    <p class="eyebrow">About</p>
    <h1 class="mt-4 max-w-4xl">
      Strategic architect for <span class="whitespace-nowrap"><span class="font-extrabold">bold</span> transitions</span>
    </h1>
    <p class="mt-6 max-w-3xl text-lg text-ink-soft">
      I guide individuals and organizations through the liminal phases of
      transformation: those uncertain, in-between spaces where the old no longer
      fits and the new hasn't fully emerged. I work with leaders, founders, and
      high achievers who want to move through that passage deliberately, rather
      than just endure it.
    </p>
  </section>

  <!-- Intro + portrait -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      {
        portrait && (
          <Image
            src={portrait}
            alt="Mehdi Moutahir"
            class="w-full rounded-2xl object-cover shadow-sm"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 100vw, 500px"
          />
        )
      }
      <div>
        <h2 class="text-3xl">Change is inevitable, but growth is intentional</h2>
        <div class="mt-6 space-y-4 text-ink-soft">
          <p>
            I care deeply about living with purpose and intention, and my work is
            guiding people toward lives of genuine fulfilment.
          </p>
          <p>
            Drawing on the Japanese idea of ikigai, I help clients bring their
            passions, talents, and contributions into balance across the whole of
            their lives. Through our work, you learn to define success on your own
            terms, holding meaningful work alongside rich relationships and a
            sense of community.
          </p>
        </div>
        <h2 class="mt-10 text-3xl">Four cultures, thirty countries, one throughline</h2>
        <div class="mt-6 space-y-4 text-ink-soft">
          <p>
            I have lived inside four distinct cultures: Morocco and Sweden as a
            child, France as a student, the United States as an adult. Each move
            dismantled my assumptions and rebuilt my sense of who I was. I came to
            know profound change from the inside long before it became my work.
          </p>
          <p>
            A global career has since carried me through more than thirty
            countries and a range of fields, from academia to entrepreneurship to
            organizational psychology.
          </p>
          <p>
            Today I split my time between Provence and Providence. Through all of
            it, one question has stayed with me: what allows a person to move
            through profound change and come out coherent, their life, their
            values, and their relationships in alignment? I have lived that
            question. And now, walking alongside others as they live theirs is
            the work I do.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Methodology pillars -->
  <section class="bg-paper-warm">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="eyebrow">Approach</p>
      <h2 class="mt-3 max-w-2xl">A holistic, evidence-based practice</h2>
      <div class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {
          pillars.map((p) => (
            <div>
              <h3 class="text-xl text-ink">{p.title}</h3>
              <p class="mt-2 text-ink-soft">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Field note: where the work comes from -->
  <section class="mx-auto max-w-3xl px-6 py-8">
    <a
      href="/field-notes/the-liminal-odyssey"
      class="group grid overflow-hidden rounded-2xl border border-line bg-paper-warm/40 transition-shadow hover:shadow-md sm:grid-cols-2"
    >
      {
        fieldNoteImg && (
          <Image
            src={fieldNoteImg}
            alt="Mehdi on the summit of Castor, ice axe raised"
            class="h-full min-h-44 w-full object-cover"
            widths={[400, 800]}
            sizes="(max-width: 640px) 100vw, 340px"
          />
        )
      }
      <div class="flex flex-col justify-center p-6 md:p-8">
        <p class="eyebrow text-blueberry">Field note</p>
        <h3 class="mt-2 text-2xl text-ink group-hover:text-apricot">Where this work comes from</h3>
        <p class="mt-3 text-ink-soft">
          A personal reflection on the first Liminal Odyssey and the year that
          followed it into the mountains.
        </p>
        <span class="mt-4 inline-flex items-center gap-2 font-heading font-medium text-apricot">
          Read the field note
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
    </a>
  </section>

  <Cta />
</Base>
