---
import BookButton from "./BookButton.astro";

interface Props {
  heading?: string;
}
const { heading = "Ready to level up?" } = Astro.props;
---

<section class="bg-paper-warm">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-6 py-20 text-center">
    <h2 class="max-w-2xl">{heading}</h2>
    <BookButton label="Book an Appointment" />
  </div>
</section>
