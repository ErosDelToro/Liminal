---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { getImage } from "../../lib/images";

export async function getStaticPaths() {
  const retreats = await getCollection("retreats");
  return retreats.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, all: retreats },
  }));
}

const { entry, all } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// "More retreats": the other three, by order, wrapping around.
const others = all
  .filter((r) => r.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);
const start = others.findIndex((r) => r.data.order > data.order);
const more = [...others.slice(start === -1 ? 0 : start), ...others].slice(0, 3);

const hero = getImage(data.heroImage);

// A field note tied to this retreat, if one exists (drives the teaser block).
const note = (await getCollection("fieldnotes")).find(
  (n) => !n.data.draft && n.data.relatedRetreats.includes(entry.id),
);

const origin = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/$/, "");
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${origin}/` },
    { "@type": "ListItem", position: 2, name: "Retreats", item: `${origin}/retreats` },
    { "@type": "ListItem", position: 3, name: data.title, item: `${origin}/retreats/${entry.id}` },
  ],
};
---

<Base
  title={data.seoTitle ?? `${data.title} | Liminal Coaching`}
  description={data.seoDescription}
  schema={breadcrumb}
>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24">
    <a href="/retreats" class="font-heading text-sm text-apricot hover:underline">← All retreats</a>
    <p class="mt-8 eyebrow text-blueberry">{data.tagline}</p>
    <h1 class="mt-2 max-w-3xl">{data.title}</h1>
    <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-xs font-heading font-medium text-blueberry">
      Private · by invitation
    </p>
    <p class="mt-6 max-w-2xl text-lg text-ink-soft">{data.intro}</p>

    {
      (data.location || data.dates) && (
        <div class="mt-8 flex flex-wrap gap-x-10 gap-y-3">
          {data.location && (
            <div>
              <p class="eyebrow text-blueberry">Location</p>
              <p class="mt-1 font-heading text-ink">
                {data.venueUrl ? (
                  <a href={data.venueUrl} class="underline decoration-1 underline-offset-4 hover:text-apricot" target="_blank" rel="noopener">
                    {data.location}
                  </a>
                ) : (
                  data.location
                )}
              </p>
            </div>
          )}
          {data.dates && (
            <div>
              <p class="eyebrow text-blueberry">Dates</p>
              <p class="mt-1 font-heading text-ink">{data.dates}</p>
            </div>
          )}
        </div>
      )
    }
  </section>

  {
    hero && (
      <section class="mx-auto max-w-6xl px-6 py-12">
        <Image
          src={hero}
          alt={data.title}
          class="aspect-[21/9] w-full rounded-2xl object-cover"
          widths={[600, 1200]}
          sizes="(max-width: 1152px) 100vw, 1152px"
          loading="eager"
        />
        {data.heroCredit && (
          <p class="mt-2 text-right text-xs text-blueberry">
            Photo:{" "}
            {data.heroCredit.authorUrl ? (
              <a href={data.heroCredit.authorUrl} class="underline hover:text-apricot" target="_blank" rel="noopener">
                {data.heroCredit.author}
              </a>
            ) : (
              data.heroCredit.author
            )}
            {" · "}
            {data.heroCredit.licenseUrl ? (
              <a href={data.heroCredit.licenseUrl} class="underline hover:text-apricot" target="_blank" rel="noopener">
                {data.heroCredit.license}
              </a>
            ) : (
              data.heroCredit.license
            )}
          </p>
        )}
      </section>
    )
  }

  <!-- Trailer (only when a vimeoId is set) -->
  {
    data.vimeoId && (
      <section class="mx-auto max-w-4xl px-6 pt-4 pb-8">
        <p class="eyebrow text-blueberry">A glimpse of the first voyage</p>
        <div class="mt-4 aspect-video overflow-hidden rounded-2xl bg-ink shadow-sm">
          <iframe
            src={`https://player.vimeo.com/video/${data.vimeoId}?title=0&byline=0&portrait=0&dnt=1`}
            class="h-full w-full"
            title={`${data.title} trailer`}
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        </div>
      </section>
    )
  }

  <!-- Body + highlights -->
  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="space-y-4 text-ink-soft [&_em]:text-blueberry [&_p]:leading-relaxed">
        <Content />
      </div>
      <div class="space-y-8">
        {
          data.highlights.map((h) => (
            <div>
              <h3 class="text-xl text-ink">{h.title}</h3>
              <p class="mt-2 text-ink-soft">{h.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Field note (if one relates to this retreat) -->
  {
    note && (
      <section class="mx-auto max-w-6xl px-6 pt-8 pb-4">
        <div class="rounded-2xl border border-line bg-paper-warm/50 p-8 md:p-12">
          <p class="eyebrow text-blueberry">Field note</p>
          <h2 class="mt-3 text-2xl text-ink md:text-3xl">{note.data.title}</h2>
          <div class="mt-6 max-w-2xl space-y-4 text-ink-soft [&_p]:leading-relaxed">
            {note.data.teaser
              .split(/\n\s*\n/)
              .map((para, i, arr) =>
                i === arr.length - 1 ? (
                  <p class="font-heading text-lg text-ink">{para.trim()}</p>
                ) : (
                  <p>{para.trim()}</p>
                ),
              )}
          </div>
          <a
            href={`/field-notes/${note.id}`}
            class="mt-8 inline-flex items-center gap-2 font-heading font-medium text-apricot hover:underline"
          >
            Read the full story
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </section>
    )
  }

  <!-- More retreats -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="mb-10">More retreats</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {
        more.map((r) => {
          const img = getImage(r.data.heroImage);
          return (
            <a
              href={`/retreats/${r.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-line bg-paper-warm/40 transition-shadow hover:shadow-md"
            >
              {img && (
                <Image
                  src={img}
                  alt={r.data.title}
                  class="aspect-[16/10] w-full object-cover"
                  widths={[300, 600]}
                  sizes="(max-width: 768px) 100vw, 360px"
                />
              )}
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-lg text-ink group-hover:text-apricot">{r.data.title}</h3>
                <p class="mt-2 flex-1 text-sm text-ink-soft">{r.data.tagline}</p>
                <span class="mt-3 inline-flex items-center gap-2 font-heading font-medium text-sm text-apricot">
                  Explore
                  <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <Cta />
</Base>
