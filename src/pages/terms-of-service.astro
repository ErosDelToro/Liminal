---
import Base from "../layouts/Base.astro";
import { CONTACT_EMAIL } from "../config";

// NOTE FOR MEHDI: This is standard, reasonable terms-of-service copy for a
// coaching business, but it is not legal advice. Have it reviewed before
// launch, set your governing jurisdiction where noted, and align the
// scheduling/payment/cancellation section with how you actually run sessions.
const lastUpdated = "July 2026";

const sections = [
  {
    heading: "Acceptance of these terms",
    body: [
      "By using this website and engaging Liminal Coaching's services, you agree to these terms. If you do not agree, please do not use the site or our services.",
    ],
  },
  {
    heading: "Nature of coaching services",
    body: [
      "Coaching is a collaborative, forward-looking partnership designed to support your personal and professional growth. It is not therapy, counselling, or a substitute for professional medical, psychological, legal, or financial advice. If you need support of that kind, we encourage you to consult an appropriately qualified professional.",
      "You are responsible for your own decisions, actions, and results. Coaching may explore sensitive topics, and you may decline to discuss anything at any time.",
    ],
  },
  {
    heading: "No guarantee of results",
    body: [
      "Coaching outcomes depend on many factors, including your own engagement and circumstances. While we bring experience, care, and evidence-informed methods to every engagement, we cannot and do not guarantee specific results.",
    ],
  },
  {
    heading: "Scheduling, payment, and cancellation",
    body: [
      "Details of session length, fees, payment terms, and cancellation or rescheduling policies are agreed with you before an engagement begins. Please give as much notice as possible if you need to reschedule so the time can be offered to someone else.",
    ],
  },
  {
    heading: "Confidentiality",
    body: [
      "We treat the content of coaching conversations as confidential and will not share it without your consent, except where disclosure is required by law or necessary to prevent serious harm.",
    ],
  },
  {
    heading: "Intellectual property",
    body: [
      "The content on this website—text, images, logos, and design—belongs to Liminal Coaching or its licensors and may not be copied or reused without permission.",
    ],
  },
  {
    heading: "Limitation of liability",
    body: [
      "To the fullest extent permitted by law, Liminal Coaching is not liable for any indirect or consequential loss arising from use of this website or our services. Nothing in these terms limits liability that cannot be limited by law.",
    ],
  },
  {
    heading: "Governing law",
    body: [
      "These terms are governed by the laws of the jurisdiction in which Liminal Coaching operates. Any disputes will be handled by the courts of that jurisdiction.",
    ],
  },
  {
    heading: "Changes to these terms",
    body: [
      "We may update these terms from time to time. The date below reflects the most recent revision.",
    ],
  },
];
---

<Base
  title="Terms of Service | Liminal Coaching"
  description="The terms governing use of the Liminal Coaching website and services."
>
  <section class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-4">Terms of Service</h1>
    <p class="mt-3 text-sm text-blueberry">Last updated: {lastUpdated}</p>

    <div class="mt-10 space-y-10">
      {
        sections.map((s) => (
          <div>
            <h2 class="text-2xl">{s.heading}</h2>
            {s.body.map((p) => (
              <p class="mt-3 leading-relaxed text-ink-soft">{p}</p>
            ))}
          </div>
        ))
      }
      <div>
        <h2 class="text-2xl">Contact us</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Questions about these terms can be directed to
          <a href={`mailto:${CONTACT_EMAIL}`} class="font-medium text-ink underline underline-offset-4 hover:text-apricot">{CONTACT_EMAIL}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
