---
import { NAV_LINKS, SERVICE_LINKS } from "../config";
import BookButton from "./BookButton.astro";

// Highlight the current page in the nav.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Liminal home">
      <!-- Brand mark: three bars (full · short · full). Rendered inline so the
           wordmark uses the page's Hanken Grotesk font and weight. -->
      <svg class="h-8 w-auto" viewBox="0 0 38 48" fill="none" aria-hidden="true">
        <line x1="4" y1="2" x2="4" y2="46" stroke="#26303B" stroke-width="4.2" stroke-linecap="round" />
        <!-- Middle bar: same slanted, round-capped stroke as the wordmark I's. -->
        <line x1="21.5" y1="12" x2="16.5" y2="36" stroke="#F7882F" stroke-width="4.2" stroke-linecap="round" />
        <line x1="34" y1="2" x2="34" y2="46" stroke="#26303B" stroke-width="4.2" stroke-linecap="round" />
      </svg>
      <span class="font-heading text-2xl font-bold leading-none tracking-[0.22em] text-ink">L<svg aria-hidden="true" viewBox="0 0 14 34" fill="none" style="display:inline-block;height:1em;vertical-align:-0.11em"><line x1="7" y1="7" x2="3" y2="27" stroke="#F7882F" stroke-width="4" stroke-linecap="round"/></svg>M<svg aria-hidden="true" viewBox="0 0 14 34" fill="none" style="display:inline-block;height:1em;vertical-align:-0.11em"><line x1="7" y1="7" x2="3" y2="27" stroke="#F7882F" stroke-width="4" stroke-linecap="round"/></svg>NAL</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              "font-heading text-sm transition-colors hover:text-apricot",
              isActive(link.href) ? "text-apricot" : "text-blueberry",
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <!-- Services dropdown (hover on desktop, CSS-only) -->
      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1 font-heading text-sm text-blueberry transition-colors hover:text-apricot"
          aria-haspopup="true"
        >
          Services
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div
          class="invisible absolute right-0 top-full min-w-56 rounded-lg border border-line bg-paper-warm p-2 opacity-0 shadow-lg transition-all duration-150 group-hover:visible group-hover:opacity-100"
        >
          {
            SERVICE_LINKS.map((link) => (
              <a
                href={link.href}
                class="block rounded-md px-3 py-2 font-heading text-sm text-ink transition-colors hover:bg-paper hover:text-apricot"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <BookButton />
    </nav>

    <!-- Mobile menu toggle -->
    <button
      type="button"
      id="menu-toggle"
      class="lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="h-7 w-7 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <nav
    id="mobile-menu"
    class="hidden border-t border-line bg-paper px-6 py-4 lg:hidden"
    aria-label="Mobile"
  >
    <div class="flex flex-col gap-1">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="rounded-md px-2 py-2 font-heading text-ink hover:bg-paper-warm">
            {link.label}
          </a>
        ))
      }
      <div class="mt-1 border-t border-line pt-2">
        <p class="px-2 pb-1 eyebrow text-blueberry">Services</p>
        {
          SERVICE_LINKS.map((link) => (
            <a href={link.href} class="rounded-md px-2 py-2 font-heading text-sm text-ink hover:bg-paper-warm block">
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="mt-3">
        <BookButton class="w-full text-center" />
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
